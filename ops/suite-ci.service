[Unit]
Description=Suite CI: every gate, then the cross-app suite
Documentation=file://%h/Desktop/suite/suite-dev/docs/adr/0002-the-gate-runs-here.md

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/suite/suite-dev
# A display is what Electron needs to open a window; xvfb-run provides one.
Environment=CI=1
ExecStart=/usr/bin/env node scripts/ci.mjs --e2e
TimeoutStartSec=3600
